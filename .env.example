# QueryVerse 2.0 - Agentic Architecture Environment Configuration

# ========================================
# LLM API Keys (Required for extraction and synthesis)
# ========================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here_optional

# ========================================
# Google ADK Configuration
# ========================================
GOOGLE_ADK_CONFIG=default
# ADK project configuration for multi-agent orchestration
ADK_PROJECT_ID=query_verse_agentic
ADK_REGION=us-central1

# ========================================
# MeTTa and Hyperon Configuration
# ========================================
HYPERON_PATH=/usr/local/lib/hyperon
METTA_SPACE_NAME=&athena_kb
# Enable MeTTa self-modification features
METTA_SELF_MODIFY=true
METTA_SANDBOX_MODE=true

# ========================================
# NSAI Provider Configuration
# ========================================
NSAI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-pro
# Fallback model configuration
OPENAI_MODEL=gpt-4o-mini

# ========================================
# Processing Configuration
# ========================================
MAX_CHUNKS_PER_DOC=80
MAX_CHARS_PER_CHUNK=1600
BATCH_SIZE=10
CHUNK_OVERLAP=200

# ========================================
# Agentic Processing Settings
# ========================================
ENABLE_TOOL_SYNTHESIS=true
ENABLE_SELF_CORRECTION=true
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=300

# ========================================
# Paths and Directories
# ========================================
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
LOGS_DIR=logs
ATOMSPACE_SNAPSHOTS_DIR=data/atomspace_snapshots

# ========================================
# Development and Debugging
# ========================================
LOG_LEVEL=INFO
DEBUG_MODE=false
ENABLE_TRACE_LOGGING=false

# ========================================
# API Configuration (for Phase 2)
# ========================================
API_HOST=localhost
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]